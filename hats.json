  "scripts": {
    "HarmScript": "function isWorn()\n\tlocal handle = script.Parent\n\tif not handle then return false end\n\tlocal accessory = handle.Parent\n\tif not accessory then return false end\n\tlocal character = accessory.Parent\n\tif not character then return false end\n\treturn character:FindFirstChild(\"Humanoid\") ~= nil\nend\n\nwhile true do\n\twait(math.random(5, 20))\n\tif script.Parent and script.Parent.Parent then\n\t\tif isWorn() then\n\t\t\tlocal name = \"Harm\" .. math.random(1, 4)\n\t\t\tlocal sound = script.Parent:FindFirstChild(name)\n\t\t\tif sound then\n\t\t\t\tsound:Play()\n\t\t\tend\n\t\tend\n\tend\nend"
  }
